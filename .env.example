APP_NAME="Integration Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#------------------------------------------------------------
# Base de datos
#------------------------------------------------------------
# Coolify (recomendado si no tienes MySQL linkeado en la misma red):
#   DB_CONNECTION=sqlite
#   DB_DATABASE=/var/www/html/database/database.sqlite
#   (no hace falta DB_HOST / DB_USERNAME / DB_PASSWORD)
#
# MySQL (Coolify con recurso DB linkeado; DB_HOST = hostname interno del servicio):
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=/var/www/html/database/database.sqlite
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

#------------------------------------------------------------
# Seguridad del integration-hub
#------------------------------------------------------------
INTEGRATION_API_KEY=cambia-esta-clave-en-produccion

#------------------------------------------------------------
# Zoho OAuth — Self Client (recomendado para backend / Coolify)
#------------------------------------------------------------
# Tipo: self (Self Client) | server (Server-based Application)
ZOHO_CLIENT_TYPE=self
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Solo si ZOHO_CLIENT_TYPE=server:
# ZOHO_REDIRECT_URI=
# Scopes para Generate Code en api-console.zoho.com (referencia):
ZOHO_OAUTH_SCOPES=ZohoBooks.invoices.ALL,ZohoBooks.contacts.READ,ZohoBooks.settings.READ
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com/books/v3
ZOHO_HTTP_TIMEOUT=20
# Obtener refresh_token: php artisan zoho:exchange-grant-token {grant_token} --show-env
# Verificar conexión:     php artisan zoho:test-connection

# Custom fields (api_name) en Zoho Books
ZOHO_CF_LINK_FACTURA_SIIGO=cf_linkdefacturasiigo
ZOHO_CF_TIPO_IDENTIFICACION=cf_tipo_de_identificaci_n
ZOHO_CF_NUMERO_IDENTIFICACION=cf_n_mero_de_identificaci_n

#------------------------------------------------------------
# Siigo Nube
#------------------------------------------------------------
SIIGO_API_BASE_URL=https://api.siigo.com
SIIGO_USERNAME=
SIIGO_ACCESS_KEY=
SIIGO_PARTNER_ID=integrationHub
# Debe coincidir EXACTAMENTE con el registrado en Siigo Nube → Alianzas → Mi Credencial API
# Solo alfanumérico, sin guiones. Ej: integrationHub, zohoBooksSiigo
# Verificar: php artisan siigo:test-connection --catalog
SIIGO_HTTP_TIMEOUT=30

# Catálogos Siigo (IDs numéricos)
SIIGO_DOCUMENT_ID=
SIIGO_SELLER_ID=
SIIGO_PAYMENT_ID=
SIIGO_TAX_ID_IVA_19=

# Producto genérico en Siigo para TODAS las líneas (ignora SKU de Zoho).
# Usa el CÓDIGO del producto en Siigo (ej. 41), no solo el nombre.
SIIGO_DEFAULT_PRODUCT_CODE=41
SIIGO_DEFAULT_PRODUCT_DESCRIPTION="Articulo 41 - PANTALON DAMA"

# Si Zoho trae líneas sin IVA, tratar el precio como CON IVA incluido y gravar 19% en Siigo.
SIIGO_FORCE_IVA_ON_UNTAXED=true
# Fracción (0.19) o porcentaje (19). Vacío/0 → 0.19 por defecto.
SIIGO_IVA_RATE=0.19
SIIGO_PRICE_DECIMALS=2
# Obligatorio: ID numérico del IVA 19% en Siigo (panel /setup → impuestos)
SIIGO_TAX_ID_IVA_19=

# Defaults para crear cliente Siigo desde un contacto Zoho (Colombia / Bogotá)
SIIGO_DEFAULT_COUNTRY_CODE=CO
SIIGO_DEFAULT_STATE_CODE=11
SIIGO_DEFAULT_CITY_CODE=11001
SIIGO_DEFAULT_ADDRESS=N/A
SIIGO_DEFAULT_ID_TYPE=13

# Facturación electrónica / fechas
# today = fecha de hoy en Siigo (recomendado; evita invalid_date DIAN/Siigo)
# zoho  = intenta fecha Zoho si está dentro de la ventana (± días)
SIIGO_INVOICE_DATE_MODE=today
SIIGO_INVOICE_DATE_MAX_DAYS_PAST=3
SIIGO_INVOICE_DATE_MAX_DAYS_FUTURE=0
SIIGO_INVOICE_SEND_DIAN=false
SIIGO_INVOICE_SEND_MAIL=false
