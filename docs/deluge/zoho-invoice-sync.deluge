// =============================================================================
// Zoho Books → Siigo Nube (via Integration Hub)
// Botón personalizado en facturas.
// =============================================================================

organizationID = organization.get("organization_id");
invoiceID = invoice.get("invoice_id");

endpointURL = "https://apisiigo.hertechnology.co/api/zoho/invoice/sync";
integrationKey = "REEMPLAZAR_CON_INTEGRATION_API_KEY";

headers = Map();
headers.put("Content-Type", "application/json");
headers.put("X-INTEGRATION-KEY", integrationKey);

payload = Map();
payload.put("organization_id", organizationID);
payload.put("invoice_id", invoiceID);

response = invokeurl
[
	url :endpointURL
	type :POST
	parameters:payload.toString()
	headers:headers
];

info response;

resultMap = Map();

if(response == null)
{
	resultMap.put("code",1);
	resultMap.put("message","Sin respuesta del Integration Hub.");
	return resultMap;
}

respText = response.toString();

if(response.get("success") == true)
{
	siigoID = ifnull(response.get("siigo_invoice_id"),"");
	siigoLink = ifnull(response.get("siigo_invoice_link"),"");
	resultMap.put("code",0);
	resultMap.put("message","Factura creada en Siigo. ID: " + siigoID + " | Link: " + siigoLink);
	return resultMap;
}

msg = ifnull(response.get("message"),"");
details = ifnull(response.get("details"),Map());
if(details != null && details.toString() != "{}" && details.toString() != "")
{
	msg = msg + " | Detalles: " + details.toString();
}
if(msg == "")
{
	msg = "Respuesta hub: " + respText;
}
resultMap.put("code",1);
resultMap.put("message",msg);
return resultMap;
